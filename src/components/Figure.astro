---
// In-article photo for MDX: <Figure src={img} alt="…" caption="…" credit="…" creditUrl="…" license="…" licenseUrl="…" />
// Lazy-loaded (below the fold), shown whole, always credited.
import type { ImageMetadata } from 'astro';
import HeroFigure from './HeroFigure.astro';

interface Props { src: ImageMetadata; alt: string; caption?: string; credit: string; creditUrl?: string; license?: string; licenseUrl?: string }
const p = Astro.props;
---

<div class="in-article"><HeroFigure {...p} eager={false} /></div>

<style>
  .in-article { margin-block: 1.75rem; }
  .in-article :global(img) { max-height: 380px; }
</style>
