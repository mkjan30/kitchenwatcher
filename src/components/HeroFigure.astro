---
// Hero image shown whole (never cropped: press-kit and CC terms), with caption + credit + licence links.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata; alt: string; credit?: string; creditUrl?: string; license?: string; licenseUrl?: string; caption?: string; eager?: boolean;
}
const { src, alt, credit, creditUrl, license, licenseUrl, caption, eager = true } = Astro.props;
---

<figure class="hero-figure">
  <Picture src={src} alt={alt} widths={[360, 720, 960]} sizes="(max-width: 700px) 92vw, 680px" formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption} </span>}
      {credit && <span>Photo: {creditUrl ? <a href={creditUrl} rel="noopener">{credit}</a> : credit}{license && <>, {licenseUrl ? <a href={licenseUrl} rel="license noopener">{license}</a> : license}</>}.</span>}
    </figcaption>
  )}
</figure>

<style>
  .hero-figure { margin: 0 0 1rem; }
  .hero-figure :global(img) { width: 100%; height: auto; max-height: 440px; object-fit: contain; background: var(--tint); }
  figcaption { font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem; line-height: 1.45; }
  figcaption a { color: inherit; }
</style>
