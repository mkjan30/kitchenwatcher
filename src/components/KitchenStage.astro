---
// Homepage hero visual: a floating air fryer with steam, orbited by a 3D carousel of kitchen gear.
// Pure CSS 3D. Each tile counter-rotates at the same rate as the ring, so it always faces the viewer.
import { iconSvg } from './kitchen-icons';

const ring = [
  ['mug', 'Mugs'],
  ['blender', 'Blenders'],
  ['teapot', 'Kettles'],
  ['microwave', 'Microwaves'],
  ['coffee', 'Coffee'],
  ['fireExtinguisher', 'Fire safety'],
];
---

<div class="stage" aria-hidden="true">
  <div class="scene">
    <div class="spin">
      {ring.map(([icon, label], i) => (
        <div class="slot" style={`--a:${(360 / ring.length) * i}deg`}>
          <div class="tile">
            <span class="ico" set:html={iconSvg(icon)} />
            <span class="lbl">{label}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="hero-item">
      <span class="steam"><i></i><i></i><i></i></span>
      <span class="big" set:html={iconSvg('airFryer', 1.3)} />
      <span class="plate"></span>
    </div>
  </div>
</div>

<style>
  .stage { --r: 215px; --tile: 92px; --tilt: 52deg; aspect-ratio: 1; margin-block: 1rem; width: min(100%, 520px); justify-self: center; perspective: 1000px; display: grid; place-items: center; }
  .scene { position: relative; width: 1px; height: 1px; transform-style: preserve-3d; transform: translateY(20px) rotateX(calc(var(--tilt) * -1)); }
  .spin { position: absolute; inset: 0; transform-style: preserve-3d; }
  .slot { position: absolute; left: 0; top: 0; transform-style: preserve-3d; transform: rotateY(var(--a)) translateZ(var(--r)); }
  .tile {
    position: absolute; left: calc(var(--tile) / -2); top: calc(var(--tile) / -2); width: var(--tile); height: var(--tile);
    display: grid; place-items: center; align-content: center; gap: 0.35rem; border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02)), rgb(28 19 13 / 0.75);
    border: 1px solid rgb(var(--accent-rgb) / 0.35);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.04) inset, 0 12px 40px -12px rgb(var(--accent-rgb) / 0.55);
    transform: rotateY(calc(var(--a) * -1)) rotateX(var(--tilt));
  }
  .ico { width: 40px; height: 40px; color: var(--accent-2); filter: drop-shadow(0 0 8px rgb(var(--accent-rgb) / 0.7)); }
  .ico :global(svg), .big :global(svg) { width: 100%; height: 100%; display: block; }
  .lbl { font: 500 0.62rem var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-2); }

  .hero-item { position: absolute; left: -90px; top: -110px; width: 180px; height: 220px; display: grid; justify-items: center; align-content: end; transform: rotateX(var(--tilt)) translateY(-30px); }
  .big { width: 150px; height: 150px; color: var(--accent); filter: drop-shadow(0 0 14px rgb(var(--accent-rgb) / 0.9)) drop-shadow(0 0 40px rgb(var(--accent-rgb) / 0.5)); }
  .plate { width: 170px; height: 26px; margin-top: 6px; border-radius: 50%; background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.55), transparent); filter: blur(4px); }
  .steam { position: absolute; top: 0; left: 50%; width: 60px; height: 70px; transform: translateX(-50%); }
  .steam i { position: absolute; bottom: 0; width: 3px; height: 34px; border-radius: 3px; background: linear-gradient(to top, rgb(255 196 150 / 0.9), transparent); opacity: 0; }
  .steam i:nth-child(1) { left: 14px; }
  .steam i:nth-child(2) { left: 29px; height: 44px; }
  .steam i:nth-child(3) { left: 44px; }

  @media (prefers-reduced-motion: no-preference) {
    .spin { animation: orbit 36s linear infinite; }
    .tile { animation: face 36s linear infinite; }
    .hero-item { animation: float 5s ease-in-out infinite; }
    .steam i { animation: steam 2.6s ease-out infinite; }
    .steam i:nth-child(2) { animation-delay: 0.7s; }
    .steam i:nth-child(3) { animation-delay: 1.4s; }
  }
  @media (prefers-reduced-motion: reduce) { .steam i { opacity: 0.5; } }
  @keyframes orbit { to { transform: rotateY(360deg); } }
  @keyframes face {
    from { transform: rotateY(calc(var(--a) * -1)) rotateX(var(--tilt)); }
    to { transform: rotateY(calc(var(--a) * -1 - 360deg)) rotateX(var(--tilt)); }
  }
  @keyframes float { 50% { transform: rotateX(var(--tilt)) translateY(-44px); } }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(10px) scaleY(0.6); }
    30% { opacity: 0.9; }
    100% { opacity: 0; transform: translateY(-40px) scaleY(1.2) translateX(4px); }
  }

  @media (max-width: 860px) {
    .stage { --r: 138px; --tile: 64px; width: min(92vw, 380px); }
    .ico { width: 26px; height: 26px; }
    .lbl { font-size: 0.5rem; }
    .big { width: 110px; height: 110px; }
    .hero-item { left: -70px; top: -85px; width: 140px; height: 170px; }
    .plate { width: 130px; }
  }
</style>
