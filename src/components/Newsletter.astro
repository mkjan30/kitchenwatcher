---
// Buttondown signup. Plain HTML POST (no JS); Buttondown opens its confirm page in a new tab and sends a double opt-in email.
interface Props { id: string; compact?: boolean }
const { id, compact = false } = Astro.props;
---

<form class:list={['nl', { compact }]} action="https://buttondown.com/api/emails/embed-subscribe/kitchenwatcher" method="post" target="_blank">
  {!compact && <p class="nl-h">Get new guides and recall alerts by email</p>}
  <p class="nl-dek">{compact ? 'New guides and recall alerts by email, about once a month.' : 'About once a month.'} Unsubscribe in one click. <a href="/privacy/">Privacy</a></p>
  <div class="nl-row">
    <label for={id} class="sr">Email address</label>
    <input type="email" name="email" id={id} required autocomplete="email" placeholder="you@example.com" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Subscribe</button>
  </div>
</form>

<style>
  .nl { background: var(--tint); padding: 1.1rem 1.25rem; margin-block: 2rem; }
  .nl.compact { background: none; padding: 0; margin: 0.75rem 0 0; }
  .nl-h { margin: 0 0 0.2rem; font-weight: 700; font-size: 1.05rem; }
  .nl-dek { margin: 0 0 0.6rem; font-size: 0.85rem; color: var(--ink-2); }
  .nl-dek a { color: inherit; }
  .nl-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .nl input[type='email'] { flex: 1 1 14rem; min-height: 44px; padding: 0 0.75rem; font: inherit; border: 1px solid var(--muted); border-radius: 2px; background: #fff; color: #111; }
  .nl button { min-height: 44px; padding: 0 1.1rem; font: inherit; font-weight: 700; background: var(--accent); color: #fff; border: 0; border-radius: 2px; cursor: pointer; }
  .nl button:focus-visible, .nl input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
