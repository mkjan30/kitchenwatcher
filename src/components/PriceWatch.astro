---
// ponytail: static placeholder. Swap for the D1 JSON export (90-day line, all-time low, verdict) when workers/price-watch ships.
import { getProduct, usd } from '../lib/site';

interface Props { product_id: string }
const p = getProduct(Astro.props.product_id);
---

<section class="pw" aria-labelledby={`pw-${p.id}`}>
  <h2 id={`pw-${p.id}`}>Price watch</h2>
  <p>
    {p.last_price_cents !== null ? <>Last price we saw: <strong class="v">{usd(p.last_price_cents)}</strong>. </> : null}
    Daily price history and drop alerts for the {p.name} start once our tracker is live.
  </p>
</section>

<style>
  .pw { background: var(--tint); padding: 1.1rem 1.25rem; margin-block: 2.5rem; border-left: 4px solid var(--accent); }
  .pw h2 { margin: 0 0 0.3rem; font-size: 1.15rem; }
  .pw p { margin: 0; color: var(--ink-2); }
  .v { font-weight: 700; }
</style>
