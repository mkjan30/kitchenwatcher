---
import AffiliateLink from './AffiliateLink.astro';
import { getProduct, merchantName, reviewFor, urlFor, usd } from '../lib/site';

interface Props { product_id: string; rank?: number }
const { product_id, rank } = Astro.props;
const p = getProduct(product_id);
const review = await reviewFor(product_id);
const score = review?.data.score;
const [first, ...rest] = p.merchants;
---

<section class="pcard">
  {rank && <span class="rank" aria-label={`Rank ${rank}`}>{rank}</span>}
  <div class="body">
    <p class="brand-line">{p.brand}</p>
    <h3>{review ? <a href={urlFor(review)}>{p.name}</a> : p.name}</h3>
    {review?.data.verdict && <p class="verdict">{review.data.verdict}</p>}
    <p class="facts">
      {p.last_price_cents !== null && <span><span class="k">Last price</span> <span class="v">{usd(p.last_price_cents)}</span></span>}
      {!review && <span class="status">In testing</span>}
    </p>
    {first && (
      <p class="buy">
        <AffiliateLink product_id={p.id} merchant={first.id} class="btn btn-primary">Check price at {merchantName(first.id)}</AffiliateLink>
        {rest.map((m) => <AffiliateLink product_id={p.id} merchant={m.id} class="btn btn-ghost">{merchantName(m.id)}</AffiliateLink>)}
      </p>
    )}
  </div>
  {score !== undefined && (
    <p class="score" style={`--s:${score}`} aria-label={`Score ${score} out of 10`}><strong>{score}</strong><span>/10</span></p>
  )}
</section>

<style>
  .pcard { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem 1.25rem; align-items: start; padding: 1.4rem; margin-block: 1rem; transition: border-color 200ms, transform 300ms var(--ease); }
  .pcard:hover { border-color: rgb(var(--accent-rgb) / 0.35); transform: perspective(900px) rotateX(2deg) translateY(-3px); }
  .pcard:not(:has(.rank)) { grid-template-columns: 1fr auto; }
  .rank { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 12px; background: var(--accent-soft); border: 1px solid rgb(var(--accent-rgb) / 0.4); color: var(--accent); font: 500 1rem/1 var(--mono); }
  .brand-line { margin: 0; font: 500 0.72rem var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--accent); }
  h3 { margin: 0.1rem 0 0.4rem; font-size: 1.1875rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .verdict { margin: 0 0 0.5rem; color: var(--ink-2); }
  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0 0 0.9rem; font-size: 0.875rem; }
  .k { color: var(--muted); }
  .v { font-family: var(--mono); font-weight: 500; }
  .status { font: 500 0.7rem var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); border: 1px solid rgb(var(--accent-rgb) / 0.3); padding: 0.2rem 0.6rem; border-radius: 999px; }
  .buy { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
  /* HUD ring gauge: arc length = score / 10 */
  .score { margin: 0; width: 76px; height: 76px; border-radius: 50%; display: grid; place-content: center; text-align: center; line-height: 1; font-family: var(--mono);
    background: radial-gradient(closest-side, var(--surface-solid) 78%, transparent 80% 100%), conic-gradient(var(--accent) calc(var(--s) * 36deg), rgb(255 255 255 / 0.08) 0);
    box-shadow: 0 0 24px -6px rgb(var(--accent-rgb) / 0.6); }
  .score strong { font-size: 1.4rem; font-weight: 500; color: var(--ink); }
  .score span { color: var(--muted); font-size: 0.7rem; }
  @media (max-width: 560px) {
    .pcard, .pcard:not(:has(.rank)) { grid-template-columns: 1fr; }
    .rank { order: -1; }
    .score { text-align: left; order: -1; }
  }
</style>
