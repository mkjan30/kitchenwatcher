---
import AffiliateLink from './AffiliateLink.astro';
import { getProduct, merchantName, reviewFor, urlFor, usd } from '../lib/site';

interface Props { product_id: string; rank?: number }
const { product_id, rank } = Astro.props;
const p = getProduct(product_id);
const review = await reviewFor(product_id);
const [first, ...rest] = p.merchants;
const label = rank === 1 ? 'Our pick' : rank ? `No. ${rank}` : p.brand;
---

<section class:list={['pick', { top: rank === 1 }]}>
  <p class="label">{label}</p>
  <h3>{review ? <a href={urlFor(review)}>{p.name}</a> : p.name}</h3>
  {review?.data.verdict && <p class="verdict">{review.data.verdict}</p>}
  <p class="facts">
    {!review && <span class="status">Research in progress</span>}
    {p.last_price_cents !== null && <span>Last seen at <strong>{usd(p.last_price_cents)}</strong></span>}
  </p>
  {first && (
    <p class="buy">
      <AffiliateLink product_id={p.id} merchant={first.id} class="btn btn-primary">Check price at {merchantName(first.id)}</AffiliateLink>
      {rest.map((m) => <AffiliateLink product_id={p.id} merchant={m.id} class="btn btn-ghost">{merchantName(m.id)}</AffiliateLink>)}
    </p>
  )}
</section>

<style>
  .pick { border-top: 1px solid var(--ink); padding: 1rem 0 1.5rem; margin-block: 1.25rem; }
  .pick.top { border-top-width: 4px; }
  .label { margin: 0 0 0.35rem; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  h3 { margin: 0 0 0.4rem; font-size: 1.35rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .verdict { margin: 0 0 0.6rem; font-family: var(--serif); font-size: 1.05rem; color: var(--ink-2); }
  .facts { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin: 0 0 0.9rem; font-size: 0.875rem; color: var(--muted); }
  .facts strong { color: var(--ink); }
  .status { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .buy { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
</style>
