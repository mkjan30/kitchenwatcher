---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { urlFor } from '../lib/site';

interface Props { recipe: CollectionEntry<'recipes'> }
const { recipe } = Astro.props;
const d = recipe.data;
---

<a class="rcard" href={urlFor(recipe)}>
  {d.hero && d.hero_alt
    ? <Picture src={d.hero} alt={d.hero_alt} width={480} height={300} fit="cover" formats={['avif', 'webp']} />
    : <span class="ph" aria-hidden="true"></span>}
  <span class="t">{d.title}</span>
  {d.prep_min !== undefined && d.cook_min !== undefined && <span class="m">{d.prep_min + d.cook_min} min</span>}
</a>

<style>
  .rcard { display: grid; gap: 0.5rem; max-width: 320px; color: var(--ink); text-decoration: none; }
  .rcard :global(img), .ph { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; }
  .ph { display: block; background: var(--surface-2); border: 1px solid var(--line); }
  .t { font: 700 1.1rem/1.3 var(--serif); }
  .rcard:hover .t { color: var(--accent); text-decoration: underline; }
  .m { font-size: 0.85rem; color: var(--muted); }
</style>
