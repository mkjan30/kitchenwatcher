---
interface Props { score?: number; verdict?: string; pros?: string[]; cons?: string[] }
const { score, verdict, pros = [], cons = [] } = Astro.props;
---

{score !== undefined && (
  <section class="scorebox" aria-label="Our score">
    <p class="head"><span class="num">{score}</span><span class="of">out of 10</span></p>
    {verdict && <p class="verdict">{verdict}</p>}
    <div class="pc">
      <div><h3 class="pro">What we like</h3><ul>{pros.map((p) => <li>{p}</li>)}</ul></div>
      <div><h3 class="con">Flaws but not dealbreakers</h3><ul>{cons.map((c) => <li>{c}</li>)}</ul></div>
    </div>
  </section>
)}

<style>
  .scorebox { border-top: 4px solid var(--ink); border-bottom: 1px solid var(--line); padding: 1.1rem 0 1.4rem; margin-block: 1.75rem; }
  .head { display: flex; align-items: baseline; gap: 0.6rem; margin: 0; }
  .num { font: 700 3rem/1 var(--serif); }
  .of { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .verdict { font-family: var(--serif); font-size: 1.2rem; margin: 0.6rem 0 1rem; }
  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .pc h3 { font-family: var(--sans); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 0.4rem; }
  .pro { color: var(--good); }
  .con { color: var(--bad); }
  ul { margin: 0; padding-left: 1.1rem; }
  li { margin-block: 0.3rem; }
  @media (max-width: 560px) { .pc { grid-template-columns: 1fr; } }
</style>
