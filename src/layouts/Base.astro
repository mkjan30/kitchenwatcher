---
// Site shell. Emits Organization, WebSite+SearchAction, BreadcrumbList, plus any page nodes in `ld`.
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { SITE, DISCLOSURE, abs, published } from '../lib/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; path: string }[]; // after Home; last = this page
  ld?: object[];
  disclose?: boolean; // page carries affiliate links → disclosure above content
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], ld = [], disclose = false, ogImage, noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);

const graph = [
  {
    '@type': 'Organization',
    '@id': abs('/#org'),
    name: SITE.name,
    url: SITE.url,
    logo: abs(SITE.logo),
    ...(SITE.sameAs.length && { sameAs: SITE.sameAs }),
  },
  {
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': abs('/#org') },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: abs('/search/?q={search_term_string}') },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.path),
    })),
  },
  ...ld,
];
// Escape "<" so no string in the data can close the script tag.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

const hubs = (await published('best')).map((b) => ({ name: b.data.title, path: `/best/${b.data.category}/` }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Inter';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interUrl}) format('woff2-variations');}`}></style>
    <script type="application/ld+json" set:html={json} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="brand" href="/">{SITE.name}</a>
      <nav aria-label="Main">
        {hubs.map((h) => <a href={h.path}>{h.name}</a>)}
        <a href="/how-we-test/">How we test</a>
        <a href="/search/">Search</a>
      </nav>
    </header>
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>))}
        </nav>
      )
    }
    <main id="main" data-pagefind-body>
      {disclose && <p class="disclosure">{DISCLOSURE} <a href="/affiliate-disclosure/">How we make money</a>.</p>}
      <slot />
    </main>
    <footer class="site">
      <nav aria-label="Footer">
        <a href="/about/">About</a>
        <a href="/how-we-test/">How we test</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
      </nav>
      <p>© {new Date().getFullYear()} {SITE.name}</p>
    </footer>
    {
      disclose && (
        // The one allowed script: affiliate click beacon. Endpoint ships with workers/price-watch; until then it 404s silently.
        <script is:inline>
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[data-aff]');
            if (a && navigator.sendBeacon) navigator.sendBeacon('/api/click', JSON.stringify({ aff: a.dataset.aff, page: location.pathname }));
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --ink: #1b1b1b;
    --muted: #5c5c5c;
    --paper: #fffdf9;
    --line: #e4e0d8;
    --accent: #b3401b;
    --good: #1f6b3a;
    --bad: #9b1c1c;
    --measure: 68ch;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; }
  main, header.site, footer.site, nav.crumbs { max-width: var(--measure); margin-inline: auto; padding-inline: 16px; }
  header.site { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; align-items: baseline; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  header.site nav, footer.site nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .brand { font-weight: 800; color: var(--ink); text-decoration: none; }
  nav.crumbs { font-size: 0.85rem; color: var(--muted); padding-block: 0.75rem; }
  nav.crumbs > * + *::before { content: '›'; margin: 0 0.4rem; color: var(--muted); }
  footer.site { margin-top: 4rem; padding-block: 2rem; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); }
  .disclosure { font-size: 0.85rem; color: var(--muted); border-left: 3px solid var(--line); padding-left: 0.75rem; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; display: block; overflow-x: auto; }
  th, td { border-bottom: 1px solid var(--line); padding: 0.4rem 0.6rem; text-align: left; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--paper); padding: 0.5rem; }
</style>
