---
// Site shell. Emits Organization, WebSite+SearchAction, BreadcrumbList, plus any page nodes in `ld`.
import sansUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoMedUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import { SITE, DISCLOSURE, abs, humanize, published } from '../lib/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; path: string }[]; // after Home; last = this page
  ld?: object[];
  disclose?: boolean; // page carries affiliate links → disclosure above content
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], ld = [], disclose = false, ogImage, noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);

const graph = [
  {
    '@type': 'Organization',
    '@id': abs('/#org'),
    name: SITE.name,
    url: SITE.url,
    logo: abs(SITE.logo),
    ...(SITE.sameAs.length && { sameAs: SITE.sameAs }),
  },
  {
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': abs('/#org') },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: abs('/search/?q={search_term_string}') },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.path),
    })),
  },
  ...ld,
];
// Escape "<" so no string in the data can close the script tag.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// Short nav labels from the hub slug; page titles are too long for a one-line nav.
const hubs = (await published('best')).map((b) => ({ name: humanize(b.data.category), path: `/best/${b.data.category}/` }));
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111418" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Plex Sans';font-style:normal;font-display:swap;font-weight:100 700;src:url(${sansUrl}) format('woff2-variations');}@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoUrl}) format('woff2');}@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${monoMedUrl}) format('woff2');}`}></style>
    <script type="application/ld+json" set:html={json} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main">
          {hubs.map((h) => <a href={h.path} aria-current={here.startsWith(h.path) ? 'page' : undefined}>{h.name}</a>)}
          <a href="/how-we-test/" aria-current={here === '/how-we-test/' ? 'page' : undefined}>How we test</a>
          <a href="/search/" class="search" aria-current={here === '/search/' ? 'page' : undefined}>Search</a>
        </nav>
      </div>
    </header>
    {
      crumbs.length > 0 && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>))}
        </nav>
      )
    }
    <main id="main" class="wrap" data-pagefind-body>
      {disclose && <p class="disclosure">{DISCLOSURE} <a href="/affiliate-disclosure/">How we make money</a></p>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <p class="brand-foot">{SITE.name}<span>Kitchen gear, measured. Prices, watched.</span></p>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-test/">How we test</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
    {
      disclose && (
        // The one allowed script: affiliate click beacon. Endpoint ships with workers/price-watch; until then it 404s silently.
        <script is:inline>
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[data-aff]');
            if (a && navigator.sendBeacon) navigator.sendBeacon('/api/click', JSON.stringify({ aff: a.dataset.aff, page: location.pathname }));
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  /* Tokens. Cool neutral paper, one cobalt accent; green/red only for pros/cons and price verdicts. */
  :root {
    --bg: #f6f7f9;
    --surface: #ffffff;
    --surface-2: #eef0f4;
    --ink: #14171c;
    --ink-2: #3d4450;
    --muted: #5d6573;
    --line: #dde1e8;
    --line-strong: #c3c9d3;
    --accent: #1f47c2;
    --accent-ink: #ffffff;
    --accent-soft: #e6ecfb;
    --good: #17693f;
    --good-soft: #e5f3eb;
    --bad: #a3261c;
    --bad-soft: #fbe9e7;
    --radius: 10px;
    --shadow: 0 1px 2px rgb(20 23 28 / 0.05), 0 4px 16px rgb(20 23 28 / 0.05);
    --sans: 'Plex Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --mono: 'Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --measure: 70ch;
    --page: 1120px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111418;
      --surface: #181c22;
      --surface-2: #20252d;
      --ink: #eceef2;
      --ink-2: #c9ced7;
      --muted: #9aa2af;
      --line: #2a3039;
      --line-strong: #3a414c;
      --accent: #8aa6ff;
      --accent-ink: #0d1330;
      --accent-soft: #1c2542;
      --good: #6fd19b;
      --good-soft: #15291f;
      --bad: #ff8e84;
      --bad-soft: #321a18;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 4px 16px rgb(0 0 0 / 0.25);
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font: 400 1.0625rem/1.65 var(--sans);
    color: var(--ink);
    background: var(--bg);
    font-feature-settings: 'kern';
    text-rendering: optimizeLegibility;
  }
  img { max-width: 100%; height: auto; display: block; }
  .wrap { max-width: var(--page); margin-inline: auto; padding-inline: 20px; }

  /* Type */
  h1, h2, h3 { color: var(--ink); line-height: 1.2; letter-spacing: -0.015em; text-wrap: balance; }
  h1 { font-size: clamp(2rem, 1.4rem + 2.4vw, 2.75rem); font-weight: 650; margin: 0.5rem 0 1rem; letter-spacing: -0.025em; }
  h2 { font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.625rem); font-weight: 620; margin: 2.75rem 0 0.75rem; }
  h3 { font-size: 1.125rem; font-weight: 620; margin: 1.75rem 0 0.5rem; }
  p, li { text-wrap: pretty; }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:hover { text-decoration-thickness: 2px; }
  strong { font-weight: 620; }
  code { font: 0.9em var(--mono); background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 4px; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

  /* Article column: prose stays readable, tables and cards may use the full width. */
  main { padding-bottom: 4rem; }
  article, .prose { max-width: 760px; }
  article > p, article > ul, article > ol, .prose > p { max-width: var(--measure); }
  .meta { color: var(--muted); font-size: 0.9375rem; }

  /* Header */
  header.site { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.01em; white-space: nowrap; }
  .brand img { border-radius: 7px; }
  header.site nav { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  header.site nav a { color: var(--ink-2); text-decoration: none; font-size: 0.9375rem; font-weight: 500; padding: 0.55rem 0.75rem; border-radius: 8px; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  header.site nav a:hover { background: var(--surface-2); color: var(--ink); }
  header.site nav a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; padding-block: 0.5rem; gap: 0.25rem; }
    header.site nav { width: calc(100% + 40px); margin-inline: -20px; padding-inline: 12px; }
    header.site { position: static; }
  }

  nav.crumbs { font-size: 0.875rem; color: var(--muted); padding-block: 1.25rem 0; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  nav.crumbs a { color: var(--muted); text-decoration: none; }
  nav.crumbs a:hover { color: var(--accent); text-decoration: underline; }
  nav.crumbs > * + *::before { content: '/'; margin-right: 0.35rem; color: var(--line-strong); }
  nav.crumbs [aria-current] { color: var(--ink-2); }

  .disclosure { font-size: 0.8125rem; color: var(--muted); margin: 1rem 0 0; max-width: var(--measure); }
  .disclosure a { color: inherit; }

  /* Tables: numbers in mono, tabular. Horizontal scroll inside, never the page. */
  table { border-collapse: collapse; width: 100%; font-size: 0.9375rem; display: block; overflow-x: auto; margin: 1.25rem 0 1.75rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  thead th { background: var(--surface-2); font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); text-align: left; vertical-align: bottom; }
  th, td { padding: 0.65rem 0.9rem; text-align: left; vertical-align: top; min-width: 7rem; }
  tbody tr + tr td, tbody tr + tr th { border-top: 1px solid var(--line); }
  td { font-variant-numeric: tabular-nums; }
  td:first-child { font-weight: 550; color: var(--ink); min-width: 10rem; }
  td:not(:first-child) { color: var(--ink-2); }
  td:empty::after { content: 'Pending'; font-family: var(--sans); font-size: 0.75rem; font-weight: 600; color: var(--muted); background: var(--surface-2); padding: 0.15rem 0.5rem; border-radius: 999px; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 44px; padding: 0.6rem 1.1rem; border-radius: 8px; font: 600 0.9375rem/1 var(--sans); text-decoration: none; white-space: nowrap; transition: background-color 150ms ease, transform 150ms ease; }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, var(--ink)); }
  .btn-ghost { color: var(--ink); border: 1px solid var(--line-strong); background: var(--surface); }
  .btn-ghost:hover { background: var(--surface-2); }
  .btn:active { transform: translateY(1px); }

  /* Footer */
  footer.site { border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 0.9375rem; }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; padding-block: 2.5rem; align-items: start; }
  .brand-foot { margin: 0; font-weight: 650; color: var(--ink); display: grid; }
  .brand-foot span { font-weight: 400; color: var(--muted); }
  footer.site nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  footer.site nav a { color: var(--ink-2); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  footer.site nav a:hover { color: var(--accent); }
  .copy { grid-column: 1 / -1; margin: 0; font-size: 0.8125rem; }
  @media (max-width: 720px) { .foot { grid-template-columns: 1fr; } }

  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 20; background: var(--surface); padding: 0.75rem 1rem; }

  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }
</style>
