---
// Site shell. Emits Organization, WebSite+SearchAction, BreadcrumbList, plus any page nodes in `ld`.
import sansUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoMedUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import { SITE, DISCLOSURE, abs, humanize, published } from '../lib/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; path: string }[]; // after Home; last = this page
  ld?: object[];
  disclose?: boolean; // page carries affiliate links → disclosure above content
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], ld = [], disclose = false, ogImage, noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);

const graph = [
  {
    '@type': 'Organization',
    '@id': abs('/#org'),
    name: SITE.name,
    url: SITE.url,
    logo: abs(SITE.logo),
    ...(SITE.sameAs.length && { sameAs: SITE.sameAs }),
  },
  {
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': abs('/#org') },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: abs('/search/?q={search_term_string}') },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.path),
    })),
  },
  ...ld,
];
// Escape "<" so no string in the data can close the script tag.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// Short nav labels from the hub slug; page titles are too long for a one-line nav.
const hubs = (await published('best')).map((b) => ({ name: humanize(b.data.category), path: `/best/${b.data.category}/` }));
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0806" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Geist';font-style:normal;font-display:swap;font-weight:100 900;src:url(${sansUrl}) format('woff2-variations');}@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${monoUrl}) format('woff2');}@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${monoMedUrl}) format('woff2');}`}></style>
    <script type="application/ld+json" set:html={json} />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="floor"></span></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Main">
          {hubs.map((h) => <a href={h.path} aria-current={here.startsWith(h.path) ? 'page' : undefined}>{h.name}</a>)}
          <a href="/how-we-test/" aria-current={here === '/how-we-test/' ? 'page' : undefined}>How we test</a>
          <a href="/search/" class="search" aria-current={here === '/search/' ? 'page' : undefined}>Search</a>
        </nav>
      </div>
    </header>
    {
      crumbs.length > 0 && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>))}
        </nav>
      )
    }
    <main id="main" class="wrap" data-pagefind-body>
      {disclose && <p class="disclosure">{DISCLOSURE} <a href="/affiliate-disclosure/">How we make money</a></p>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <p class="brand-foot">{SITE.name}<span>Kitchen gear, measured. Prices, watched.</span></p>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-test/">How we test</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
    {
      disclose && (
        // The one allowed script: affiliate click beacon. Endpoint ships with workers/price-watch; until then it 404s silently.
        <script is:inline>
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[data-aff]');
            if (a && navigator.sendBeacon) navigator.sendBeacon('/api/click', JSON.stringify({ aff: a.dataset.aff, page: location.pathname }));
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  /* Dark "Ember" theme: warm near-black lit by one ember-orange accent (think heating element); green/red only for pros/cons.
     Depth = CSS 3D + scroll-driven animation. No client JS. Everything motion-related sits behind
     prefers-reduced-motion: no-preference, and scroll effects behind @supports (animation-timeline). */
  :root {
    --bg: #0b0806;
    --bg-2: #120d0a;
    --surface: rgb(30 22 17 / 0.62);
    --surface-solid: #1b1410;
    --surface-2: rgb(255 255 255 / 0.05);
    --ink: #f6efe9;
    --ink-2: #cdbfb4;
    --muted: #978a80;
    --line: rgb(255 255 255 / 0.09);
    --line-strong: rgb(255 255 255 / 0.18);
    --accent-rgb: 214 138 94;
    --accent: #d68a5e;
    --accent-2: #e8c1a3;
    --label: #b3a497;
    --accent-ink: #1c0b02;
    --accent-soft: rgb(var(--accent-rgb) / 0.1);
    --glow: 0 0 0 1px rgb(var(--accent-rgb) / 0.22), 0 14px 40px -20px rgb(var(--accent-rgb) / 0.35);
    --good: #6fe3a4;
    --good-soft: rgb(111 227 164 / 0.08);
    --bad: #ff5f7e;
    --bad-soft: rgb(255 95 126 / 0.09);
    --radius: 16px;
    --shadow: 0 1px 0 rgb(255 255 255 / 0.06) inset, 0 24px 60px -30px rgb(0 0 0 / 0.8);
    --sans: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --mono: 'Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --measure: 68ch;
    --page: 1180px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; background: var(--bg); }
  body {
    margin: 0;
    font: 400 1.0625rem/1.65 var(--sans);
    color: var(--ink);
    background: transparent;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  img { max-width: 100%; height: auto; display: block; }
  .wrap { max-width: var(--page); margin-inline: auto; padding-inline: 20px; position: relative; }
  ::selection { background: var(--accent); color: var(--accent-ink); }

  /* Ambient scene: two light orbs + a perspective grid floor, fixed behind everything. */
  .ambient { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: radial-gradient(120% 80% at 50% -10%, #19110c 0%, var(--bg) 55%); }
  .orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.22; will-change: transform; }
  .o1 { width: 42vmax; height: 42vmax; left: -12vmax; top: -14vmax; background: radial-gradient(circle, rgb(var(--accent-rgb) / 0.55), transparent 65%); }
  .o2 { width: 36vmax; height: 36vmax; right: -10vmax; top: 30vh; background: radial-gradient(circle, rgb(150 80 50 / 0.35), transparent 65%); }
  .floor {
    position: absolute; left: -50%; right: -50%; bottom: -10vh; height: 70vh;
    background-image:
      linear-gradient(rgb(var(--accent-rgb) / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(600px) rotateX(62deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 85%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .o1 { animation: drift1 22s var(--ease) infinite alternate; }
    .o2 { animation: drift2 28s var(--ease) infinite alternate; }
    .floor { animation: floor 6s linear infinite; }
  }
  @keyframes drift1 { to { transform: translate3d(14vmax, 10vmax, 0) scale(1.15); } }
  @keyframes drift2 { to { transform: translate3d(-12vmax, -8vmax, 0) scale(0.9); } }
  @keyframes floor { to { background-position: 0 64px, 0 0; } }

  /* Type */
  h1, h2, h3 { color: var(--ink); line-height: 1.1; text-wrap: balance; font-weight: 650; }
  h1 { font-size: clamp(2.2rem, 1.4rem + 3vw, 3.4rem); margin: 0.5rem 0 1rem; letter-spacing: -0.035em; }
  h2 { font-size: clamp(1.45rem, 1.2rem + 1vw, 1.9rem); margin: 3rem 0 0.85rem; letter-spacing: -0.025em; }
  h3 { font-size: 1.15rem; margin: 1.75rem 0 0.5rem; letter-spacing: -0.01em; }
  p, li { text-wrap: pretty; }
  a { color: var(--accent-2); text-decoration-color: rgb(var(--accent-rgb) / 0.45); text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: color 150ms, text-decoration-color 150ms; }
  a:hover { color: var(--ink); text-decoration-color: currentColor; }
  strong { font-weight: 620; color: var(--ink); }
  code { font: 0.9em var(--mono); background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 6px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

  main { padding-bottom: 5rem; }
  article, .prose { max-width: 780px; }
  article > p, article > ul, article > ol, .prose > p { max-width: var(--measure); color: var(--ink-2); }
  article > ul li::marker, article > ol li::marker { color: var(--muted); }
  .meta { color: var(--muted); font-size: 0.9rem; font-family: var(--mono); letter-spacing: -0.01em; }

  /* Glass panel shared by cards, tables, boxes. */
  .glass, table, .pcard, .scorebox, .pw, .hub, .made-in, .stats div {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.045), rgb(255 255 255 / 0.015)), var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  /* Header: glass bar */
  header.site { position: sticky; top: 0; z-index: 10; background: rgb(11 8 6 / 0.6); backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 1.05rem; letter-spacing: -0.02em; white-space: nowrap; }
  .brand img { border-radius: 8px; }
  header.site nav { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  header.site nav a { color: var(--ink-2); text-decoration: none; font-size: 0.925rem; font-weight: 500; padding: 0.5rem 0.8rem; border-radius: 999px; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; border: 1px solid transparent; }
  header.site nav a:hover { color: var(--ink); background: var(--surface-2); }
  header.site nav a[aria-current='page'] { color: var(--ink); border-color: var(--line-strong); background: var(--surface-2); }
  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; padding-block: 0.5rem; gap: 0.25rem; }
    header.site nav { width: calc(100% + 40px); margin-inline: -20px; padding-inline: 12px; }
  }

  nav.crumbs { font: 0.8rem var(--mono); color: var(--muted); padding-block: 1.5rem 0; display: flex; flex-wrap: wrap; gap: 0.3rem; letter-spacing: -0.01em; }
  nav.crumbs a { color: var(--muted); text-decoration: none; }
  nav.crumbs a:hover { color: var(--accent); }
  nav.crumbs > * + *::before { content: '/'; margin-right: 0.3rem; color: var(--line-strong); }
  nav.crumbs [aria-current] { color: var(--ink-2); }

  .disclosure { font-size: 0.8rem; color: var(--muted); margin: 1rem 0 0; max-width: var(--measure); }
  .disclosure a { color: inherit; }

  /* Tables as HUD readouts */
  table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 0.925rem; display: block; overflow-x: auto; margin: 1.5rem 0 2rem; scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / 0.18) transparent; }
  thead th { font: 500 0.72rem var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--label); text-align: left; vertical-align: bottom; border-bottom: 1px solid var(--line-strong); }
  th, td { padding: 0.75rem 1rem; text-align: left; vertical-align: top; min-width: 7rem; }
  tbody tr + tr td, tbody tr + tr th { border-top: 1px solid var(--line); }
  tbody tr { transition: background-color 150ms; }
  tbody tr:hover { background: rgb(255 255 255 / 0.025); }
  td { font-variant-numeric: tabular-nums; color: var(--ink-2); }
  td:first-child { font-weight: 560; color: var(--ink); min-width: 10rem; }
  td:empty::after { content: 'Pending'; font: 500 0.7rem var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--label); border: 1px solid var(--line-strong); background: var(--surface-2); padding: 0.2rem 0.55rem; border-radius: 999px; }

  /* Buttons */
  .btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 44px; padding: 0.65rem 1.2rem; border-radius: 999px; font: 600 0.925rem/1 var(--sans); text-decoration: none; white-space: nowrap; transition: transform 200ms var(--ease), box-shadow 200ms var(--ease), background-color 200ms; }
  .btn-primary { background: var(--accent); color: var(--accent-ink); box-shadow: 0 8px 24px -12px rgb(var(--accent-rgb) / 0.5); }
  .btn-primary:hover { color: var(--accent-ink); background: var(--accent-2); box-shadow: 0 10px 28px -12px rgb(var(--accent-rgb) / 0.6); transform: translateY(-1px); }
  .btn-ghost { color: var(--ink); border: 1px solid var(--line-strong); background: rgb(255 255 255 / 0.03); }
  .btn-ghost:hover { color: var(--ink); border-color: rgb(255 255 255 / 0.28); background: var(--surface-2); }
  .btn:active { transform: translateY(1px) scale(0.99); }

  /* Footer */
  footer.site { border-top: 1px solid var(--line); background: rgb(11 8 6 / 0.7); color: var(--muted); font-size: 0.925rem; }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; padding-block: 2.75rem; align-items: start; }
  .brand-foot { margin: 0; font-weight: 650; color: var(--ink); display: grid; }
  .brand-foot span { font-weight: 400; color: var(--muted); }
  footer.site nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  footer.site nav a { color: var(--ink-2); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  footer.site nav a:hover { color: var(--accent); }
  .copy { grid-column: 1 / -1; margin: 0; font: 0.8rem var(--mono); }
  @media (max-width: 720px) { .foot { grid-template-columns: 1fr; } }

  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 20; background: var(--surface-solid); padding: 0.75rem 1rem; }

  /* 4D: content assembles in depth as it scrolls into view. Anything already on screen at load
     is past the entry range, so the LCP element (the h1) never starts hidden. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      main h2, main table, .pcard, .scorebox, .pw, .hub, .made-in, .recipes > *, .cards > *, .author {
        animation: assemble linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 85%;
      }
      @keyframes assemble {
        from { opacity: 0; transform: perspective(900px) translate3d(0, 48px, -120px) rotateX(14deg); filter: blur(6px); }
        to { opacity: 1; transform: none; filter: none; }
      }
      /* The grid floor moves with page scroll: time + scroll depth. */
      .ambient .floor { animation: floor-scroll linear both; animation-timeline: scroll(root); }
      @keyframes floor-scroll { to { background-position: 0 1600px, 0 0; } }
    }
  }

  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }
</style>
