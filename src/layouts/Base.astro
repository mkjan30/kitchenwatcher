---
// Site shell. Emits Organization, WebSite+SearchAction, BreadcrumbList, plus any page nodes in `ld`.
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansUrl from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { SITE, DISCLOSURE, abs, humanize, published } from '../lib/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; path: string }[]; // after Home; last = this page
  ld?: object[];
  disclose?: boolean; // page carries affiliate links → disclosure above content
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, crumbs = [], ld = [], disclose = false, ogImage, noindex = false } = Astro.props;
const canonical = abs(Astro.url.pathname);

const graph = [
  {
    '@type': 'Organization',
    '@id': abs('/#org'),
    name: SITE.name,
    url: SITE.url,
    logo: abs(SITE.logo),
    ...(SITE.sameAs.length && { sameAs: SITE.sameAs }),
  },
  {
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': abs('/#org') },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: abs('/search/?q={search_term_string}') },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.path),
    })),
  },
  ...ld,
];
// Escape "<" so no string in the data can close the script tag.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// Short nav labels from the hub slug; page titles are too long for a one-line nav.
const hubs = (await published('best')).map((b) => ({ name: humanize(b.data.category), path: `/best/${b.data.category}/` }));
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !SITE.indexable) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Source Serif 4';font-style:normal;font-display:swap;font-weight:200 900;src:url(${serifUrl}) format('woff2-variations');}@font-face{font-family:'Libre Franklin';font-style:normal;font-display:swap;font-weight:100 900;src:url(${sansUrl}) format('woff2-variations');}`}></style>
    <script type="application/ld+json" set:html={json} />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MVXXJ2TD');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3LK2ZJE7HN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3LK2ZJE7HN');
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVXXJ2TD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap masthead">
        <a class="wordmark" href="/" aria-label={`${SITE.name} home`}>{SITE.name}</a>
        <a class="search-link" href="/search/" aria-current={here === '/search/' ? 'page' : undefined}>Search</a>
      </div>
      <nav class="wrap sections" aria-label="Main">
        {hubs.map((h) => <a href={h.path} aria-current={here.startsWith(h.path) ? 'page' : undefined}>{h.name}</a>)}
        <a href="/how-we-research/" aria-current={here === '/how-we-research/' ? 'page' : undefined}>How we research</a>
        <a href="/about/" aria-current={here === '/about/' ? 'page' : undefined}>About</a>
      </nav>
    </header>
    {
      crumbs.length > 0 && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>))}
        </nav>
      )
    }
    <main id="main" class="wrap" data-pagefind-body>
      {disclose && <p class="disclosure">{DISCLOSURE} <a href="/affiliate-disclosure/">How we make money</a></p>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <div>
          <p class="wordmark foot-mark">{SITE.name}</p>
          <p class="foot-tag">Kitchen gear research with every source named.</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-research/">How we research</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
    {
      disclose && (
        // The one allowed script: affiliate click beacon. Endpoint ships with workers/price-watch; until then it 404s silently.
        <script is:inline>
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[data-aff]');
            if (a && navigator.sendBeacon) navigator.sendBeacon('/api/click', JSON.stringify({ aff: a.dataset.aff, page: location.pathname }));
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  /* Editorial theme: white page, near-black type, hairline rules, one forest-green accent
     for picks and buy buttons. Serif headlines (Source Serif 4), Franklin-style sans for UI and body. */
  :root {
    --bg: #ffffff;
    --tint: #f6f5f2;
    --ink: #121212;
    --ink-2: #333333;
    --muted: #666666;
    --line: #e2e2e2;
    --line-strong: #121212;
    --accent: #1d5c43;
    --accent-ink: #ffffff;
    --accent-soft: #e8f1ec;
    --good: #1d5c43;
    --good-soft: #eef5f1;
    --bad: #a3262a;
    --bad-soft: #fbefef;
    --serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --sans: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;
    --mono: var(--sans);
    --label: #666666;
    --surface: #ffffff;
    --surface-solid: #ffffff;
    --surface-2: #f6f5f2;
    --radius: 4px;
    --measure: 680px;
    --page: 1200px;
    color-scheme: light;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.65 var(--sans); -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; height: auto; display: block; }
  .wrap { max-width: var(--page); margin-inline: auto; padding-inline: 20px; }
  ::selection { background: var(--accent-soft); }

  h1, h2, h3 { font-family: var(--serif); color: var(--ink); font-weight: 700; text-wrap: balance; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2rem, 1.5rem + 2vw, 2.9rem); line-height: 1.12; margin: 0.75rem 0 0.75rem; }
  h2 { font-size: clamp(1.45rem, 1.3rem + 0.6vw, 1.75rem); line-height: 1.2; margin: 2.75rem 0 0.75rem; }
  h3 { font-size: 1.2rem; line-height: 1.3; margin: 1.75rem 0 0.4rem; }
  p, li { text-wrap: pretty; }
  a { color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:hover { color: var(--accent); text-decoration-thickness: 2px; }
  strong { font-weight: 650; }
  code { font-size: 0.9em; background: var(--tint); padding: 0.1em 0.35em; border-radius: 3px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  main { padding-bottom: 4.5rem; }
  article, .prose { max-width: var(--measure); margin-inline: auto; }
  article > p, article > ul, article > ol { font-family: var(--serif); font-size: 1.15rem; line-height: 1.7; color: var(--ink-2); }
  article > ul li, article > ol li { margin-block: 0.35rem; }
  .dek { font: 400 1.2rem/1.5 var(--sans); color: var(--ink-2); margin: 0 0 1rem; }
  .meta { color: var(--muted); font-size: 0.875rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .meta a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .meta a:hover { text-decoration: underline; }

  /* Masthead */
  header.site { border-bottom: 1px solid var(--line); background: var(--bg); }
  .masthead { position: relative; display: flex; justify-content: center; align-items: center; min-height: 72px; border-bottom: 1px solid var(--line); }
  .wordmark { font: 800 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1 var(--serif); letter-spacing: -0.03em; color: var(--ink); text-decoration: none; }
  .wordmark:hover { color: var(--ink); }
  .search-link { position: absolute; right: 20px; font-size: 0.85rem; font-weight: 600; color: var(--ink); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .sections { display: flex; justify-content: center; gap: 0.25rem 1.75rem; overflow-x: auto; scrollbar-width: none; }
  .sections a { font-size: 0.875rem; font-weight: 600; color: var(--ink); text-decoration: none; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; }
  .sections a:hover, .sections a[aria-current='page'] { border-bottom-color: var(--ink); color: var(--ink); }
  @media (max-width: 640px) {
    .masthead { justify-content: flex-start; }
    .sections { justify-content: flex-start; gap: 1.25rem; }
  }

  nav.crumbs { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; color: var(--muted); padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem; max-width: calc(var(--measure) + 40px); }
  nav.crumbs { margin-inline: auto; }
  nav.crumbs a { color: var(--accent); text-decoration: none; text-transform: uppercase; }
  nav.crumbs a:hover { text-decoration: underline; }
  nav.crumbs > * + *::before { content: '›'; margin-right: 0.3rem; color: var(--muted); }
  nav.crumbs [aria-current] { display: none; }

  .disclosure { max-width: var(--measure); margin: 0.75rem auto 0; font-size: 0.8rem; color: var(--muted); font-style: italic; }
  .disclosure a { color: inherit; }

  /* Tables */
  table { border-collapse: collapse; width: 100%; font-size: 0.925rem; display: block; overflow-x: auto; margin: 1.5rem 0 2rem; border-top: 2px solid var(--ink); font-family: var(--sans); }
  thead th { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); text-align: left; vertical-align: bottom; border-bottom: 1px solid var(--ink); }
  th, td { padding: 0.7rem 0.9rem 0.7rem 0; text-align: left; vertical-align: top; min-width: 7rem; }
  tbody td { border-bottom: 1px solid var(--line); }
  td { font-variant-numeric: tabular-nums; color: var(--ink-2); }
  td:first-child { font-weight: 650; color: var(--ink); min-width: 10rem; }
  td:empty::after { content: 'Pending'; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.6rem 1.1rem; border-radius: var(--radius); font: 700 0.875rem/1 var(--sans); text-decoration: none; white-space: nowrap; transition: background-color 150ms, color 150ms; }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover { background: #164a36; color: var(--accent-ink); }
  .btn-ghost { background: var(--bg); color: var(--ink); border: 1px solid var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: var(--bg); }

  /* Footer */
  footer.site { border-top: 1px solid var(--ink); background: var(--tint); font-size: 0.9rem; color: var(--muted); }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem 2rem; padding-block: 2.5rem; align-items: start; }
  .foot-mark { font-size: 1.4rem; margin: 0 0 0.35rem; }
  .foot-tag { margin: 0; max-width: 44ch; }
  footer.site nav { display: grid; grid-template-columns: repeat(2, auto); gap: 0 2rem; }
  footer.site nav a { color: var(--ink); text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; font-weight: 600; font-size: 0.875rem; }
  footer.site nav a:hover { text-decoration: underline; }
  .copy { grid-column: 1 / -1; margin: 0; font-size: 0.8rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  @media (max-width: 640px) { .foot { grid-template-columns: 1fr; } }

  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 20; background: var(--bg); padding: 0.75rem 1rem; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>
