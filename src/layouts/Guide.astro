---
// Guides, smart-kitchen, vs → Article (+ FAQPage only if frontmatter has faq).
// /best/ hubs → ItemList of Product, ranked by review score (never commission). No aggregateRating.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import { abs, articleLd, authorOf, getProduct, hubCrumb, iso, productLd, reviewFor, urlFor } from '../lib/site';

type Entry = CollectionEntry<'guides' | 'smart-kitchen' | 'vs' | 'best'>;
interface Props { entry: Entry }
const { entry } = Astro.props;
const d = entry.data;
const author = await authorOf(d.author);
const path = urlFor(entry);

// Only products with a published review make the list; untested gear is never ranked.
const ranked =
  entry.collection === 'best'
    ? (await Promise.all(entry.data.products.map(async (id) => ({ product: getProduct(id), review: await reviewFor(id) }))))
        .filter((x) => x.review?.data.score !== undefined)
        .sort((a, b) => b.review!.data.score! - a.review!.data.score!)
    : [];

const faq = 'faq' in d ? d.faq : undefined;
const ld: object[] =
  entry.collection === 'best'
    ? [{
        '@type': 'ItemList',
        name: d.title,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        itemListElement: ranked.map((x, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: abs(urlFor(x.review!)),
          item: productLd(x.product),
        })),
      }]
    : [articleLd(entry, author, path)];
if (faq?.length) {
  ld.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}

const productRef = 'product_id' in d ? d.product_id : entry.collection === 'vs' ? entry.data.products[0] : undefined;
const crumbs = [...(productRef && entry.collection !== 'best' ? [hubCrumb(productRef)] : []), { name: d.title, path }];
---

<Base title={d.title} description={d.description} crumbs={crumbs} ld={ld} disclose={entry.collection !== 'guides' || !!productRef} ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="meta">By <a href={`/authors/${author.id}/`}>{author.data.name}</a> · Updated <time datetime={iso(d.updated)}>{iso(d.updated)}</time></p>
    {d.hero && d.hero_alt && <Picture src={d.hero} alt={d.hero_alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 700px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />}
    {ranked.length > 0 && (
      <ol class="ranked">
        {ranked.map((x) => <li><a href={urlFor(x.review!)}>{x.product.name}</a> — {x.review!.data.score}/10</li>)}
      </ol>
    )}
    <slot />
    {faq?.length && (
      <section>
        <h2>FAQ</h2>
        {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
      </section>
    )}
  </article>
</Base>
