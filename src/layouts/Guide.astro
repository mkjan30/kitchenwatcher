---
// Guides, smart-kitchen, vs → Article (+ FAQPage only if frontmatter has faq).
// /best/ hubs → ItemList of Product in the hub's editorial order (weight of evidence, never commission).
import type { CollectionEntry } from 'astro:content';
import HeroFigure from '../components/HeroFigure.astro';
import Base from './Base.astro';
import AuthorBox from '../components/AuthorBox.astro';
import ProductCard from '../components/ProductCard.astro';
import ResearchNote from '../components/ResearchNote.astro';
import PageMeta from '../components/PageMeta.astro';
import Toc from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import type { MarkdownHeading } from 'astro';
import Sources from '../components/Sources.astro';
import { published } from '../lib/site';
import { abs, articleLd, authorOf, faqLd, getProduct, hubCrumb, iso, productLd, reviewFor, urlFor } from '../lib/site';

type Entry = CollectionEntry<'guides' | 'smart-kitchen' | 'vs' | 'best'>;
interface Props { entry: Entry; headings?: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;
const author = await authorOf(d.author);
const path = urlFor(entry);

// Only products with a published review make the list, in the order of the hub's products[].
const ranked =
  entry.collection === 'best'
    ? (await Promise.all(entry.data.products.map(async (id) => ({ product: getProduct(id), review: await reviewFor(id) }))))
        .filter((x) => x.review !== undefined)
    : [];

// Hubs list every guide/comparison in their category automatically (keeps new pages linked from their hub).
const catOf = (id?: string) => (id ? getProduct(id).category : undefined);
const related =
  entry.collection === 'best'
    ? [
        ...(await published('vs')).filter((v) => catOf(v.data.products[0]) === entry.data.category),
        ...(await published('guides')).filter((g) => g.data.hub === entry.data.category || catOf(g.data.product_id) === entry.data.category),
        ...(await published('smart-kitchen')).filter((g) => g.data.hub === entry.data.category || catOf(g.data.product_id) === entry.data.category),
      ]
    : [];
const faq = d.faq;
const ld: object[] =
  entry.collection === 'best'
    ? [{
        '@type': 'ItemList',
        name: d.title,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        itemListElement: ranked.map((x, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: abs(urlFor(x.review!)),
          item: productLd(x.product),
        })),
      }]
    : [articleLd(entry, author, path)];
ld.push(...faqLd(faq));
const tocExtra = faq?.length ? [{ slug: 'faq', text: 'Frequently asked questions' }] : [];

const productRef = 'product_id' in d ? d.product_id : entry.collection === 'vs' ? entry.data.products[0] : undefined;
const crumbs = [...(productRef && entry.collection !== 'best' ? [hubCrumb(productRef)] : []), { name: d.title, path }];
---

<Base title={d.title} description={d.description} crumbs={crumbs} ld={ld} disclose ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <PageMeta author={author} published={d.published} updated={d.updated} />
    <ResearchNote subject={entry.collection === 'best' ? 'the products on this list' : entry.collection === 'vs' ? 'either product' : productRef ? `the ${getProduct(productRef).name}` : 'the products discussed here'} />
    {d.hero && d.hero_alt && <HeroFigure src={d.hero} alt={d.hero_alt} credit={d.hero_credit} creditUrl={d.hero_credit_url} license={d.hero_license} licenseUrl={d.hero_license_url} caption={d.hero_caption} />}
    {ranked.length > 0 && (
      <section>{ranked.map((x, i) => <ProductCard product_id={x.product.id} rank={i + 1} level={2} />)}</section>
    )}
    <Toc headings={headings} extra={tocExtra} />
    <slot />
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">Guides and comparisons</h2>
        <ul>{related.map((r) => <li><a href={urlFor(r)}>{r.data.title}</a></li>)}</ul>
      </section>
    )}
    <Faq faq={faq} />
    <Sources urls={d.sources} />
    <AuthorBox author={author} />
  </article>
</Base>
