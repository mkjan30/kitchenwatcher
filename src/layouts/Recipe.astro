---
// Recipe → Recipe (instructions, nutrition if known, video if present). Carries a "Made in" box.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { abs, authorOf, getProduct, iso, personLd, reviewFor, urlFor } from '../lib/site';

interface Props { entry: CollectionEntry<'recipes'> }
const { entry } = Astro.props;
const d = entry.data;
const author = await authorOf(d.author);
const product = getProduct(d.product_id);
const review = await reviewFor(d.product_id);
const path = urlFor(entry);
const mins = (m?: number) => (m === undefined ? undefined : `PT${m}M`);

const ld = [{
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  ...(d.hero && { image: [abs(d.hero.src)] }),
  author: personLd(author),
  datePublished: iso(d.published),
  prepTime: mins(d.prep_min),
  cookTime: mins(d.cook_min),
  totalTime: d.prep_min !== undefined && d.cook_min !== undefined ? mins(d.prep_min + d.cook_min) : undefined,
  recipeYield: d.servings && `${d.servings} servings`,
  recipeCategory: 'Main course', // TODO(human): set per recipe once there are non-mains
  tool: product.name,
  keywords: [d.primary_keyword, ...d.secondary_keywords].join(', '),
  recipeIngredient: d.ingredients,
  recipeInstructions: d.steps?.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  ...(d.calories_kcal && { nutrition: { '@type': 'NutritionInformation', calories: `${d.calories_kcal} calories` } }),
  ...(d.video_url && {
    video: {
      '@type': 'VideoObject',
      name: d.title,
      description: d.description,
      contentUrl: d.video_url,
      uploadDate: iso(d.published),
      ...(d.hero && { thumbnailUrl: abs(d.hero.src) }),
    },
  }),
}];
---

<Base title={d.title} description={d.description} crumbs={[{ name: d.title, path }]} ld={ld} disclose ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <p class="meta">By <a href={`/authors/${author.id}/`}>{author.data.name}</a> · Updated <time datetime={iso(d.updated)}>{iso(d.updated)}</time></p>
    {d.hero && d.hero_alt && <Picture src={d.hero} alt={d.hero_alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 700px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />}
    <dl class="stats">
      <div><dt>Prep</dt><dd>{d.prep_min !== undefined ? `${d.prep_min} min` : 'Pending'}</dd></div>
      <div><dt>Cook</dt><dd>{d.cook_min !== undefined ? `${d.cook_min} min` : 'Pending'}</dd></div>
      <div><dt>Serves</dt><dd>{d.servings ?? 'Pending'}</dd></div>
    </dl>
    <aside class="made-in">
      <span>Made in</span>
      {review ? <a href={urlFor(review)}>{product.name}</a> : <strong>{product.name}</strong>}
    </aside>
    <h2>Ingredients</h2>
    <ul>{d.ingredients?.map((i) => <li>{i}</li>)}</ul>
    <h2>Steps</h2>
    <ol>{d.steps?.map((s) => <li>{s}</li>)}</ol>
    <slot />
    <AuthorBox author={author} />
  </article>
</Base>

<style>
  .made-in { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; padding: 0.9rem 1.1rem; margin-block: 1rem 1.5rem; background: var(--tint); border-left: 4px solid var(--accent); }
  .made-in span { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  .made-in a, .made-in strong { font: 700 1.05rem var(--serif); }
  .stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0 2.5rem; margin: 1rem 0 0; padding-block: 0.75rem; border-block: 1px solid var(--line); }
  .stats dt { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 0; font: 700 1.2rem var(--serif); }
  ol li { margin-block: 0.4rem; }
</style>
