---
// Research review → Article about a Product, author as Person with sameAs. No Review/Rating markup:
// we did not review the product first-hand (CLAUDE.md).
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import VerdictBox from '../components/VerdictBox.astro';
import ResearchNote from '../components/ResearchNote.astro';
import Sources from '../components/Sources.astro';
import PriceWatch from '../components/PriceWatch.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { abs, articleLd, authorOf, getProduct, hubCrumb, iso, productLd, urlFor } from '../lib/site';

interface Props { entry: CollectionEntry<'reviews'> }
const { entry } = Astro.props;
const d = entry.data;
const product = getProduct(d.product_id);
const author = await authorOf(d.author);
const path = urlFor(entry);

const ld = [{ ...articleLd(entry, author, path), about: { ...productLd(product), ...(d.hero && { image: abs(d.hero.src) }) } }];
---

<Base title={d.title} description={d.description} crumbs={[hubCrumb(d.product_id), { name: d.title, path }]} ld={ld} disclose ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <p class="meta">By <a href={`/authors/${author.id}/`}>{author.data.name}</a> · Updated <time datetime={iso(d.updated)}>{iso(d.updated)}</time></p>
    {d.hero && d.hero_alt && <Picture src={d.hero} alt={d.hero_alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 700px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />}
    <ResearchNote subject={`the ${product.name}`} />
    <VerdictBox verdict={d.verdict} pros={d.pros} cons={d.cons} />
    <slot />
    <PriceWatch product_id={d.product_id} />
    <Sources urls={d.sources} />
    <AuthorBox author={author} />
  </article>
</Base>
