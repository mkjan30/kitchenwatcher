---
// Review → Product + Review + Rating, author as Person with sameAs.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import { abs, authorOf, getProduct, hubCrumb, iso, personLd, productLd, urlFor, usd } from '../lib/site';

interface Props { entry: CollectionEntry<'reviews'> }
const { entry } = Astro.props;
const d = entry.data;
const product = getProduct(d.product_id);
const author = await authorOf(d.author);
const path = urlFor(entry);

const ld = d.score === undefined ? [] : [
  {
    ...productLd(product),
    ...(d.hero && { image: abs(d.hero.src) }),
    review: {
      '@type': 'Review',
      name: d.title,
      reviewBody: d.verdict,
      datePublished: iso(d.published),
      dateModified: iso(d.updated),
      author: personLd(author),
      publisher: { '@id': abs('/#org') },
      reviewRating: { '@type': 'Rating', ratingValue: d.score, bestRating: 10, worstRating: 1 },
    },
  },
];
---

<Base title={d.title} description={d.description} crumbs={[hubCrumb(d.product_id), { name: d.title, path }]} ld={ld} disclose ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="meta">
      By <a href={`/authors/${author.id}/`}>{author.data.name}</a> · Updated <time datetime={iso(d.updated)}>{iso(d.updated)}</time>
      {d.tested_on && <> · Tested {d.test_duration_days} days from <time datetime={iso(d.tested_on)}>{iso(d.tested_on)}</time></>}
      {d.price_at_review_cents && <> · {usd(d.price_at_review_cents)} at review</>}
    </p>
    {d.hero && d.hero_alt && <Picture src={d.hero} alt={d.hero_alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 700px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />}
    {/* ScoreBox: step 5 */}
    <slot />
    {/* PriceWatch + AuthorBox: step 5 */}
  </article>
</Base>
