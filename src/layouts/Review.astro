---
// Research review → Article about a Product, author as Person with sameAs. No Review/Rating markup:
// we did not review the product first-hand (CLAUDE.md).
import type { CollectionEntry } from 'astro:content';
import HeroFigure from '../components/HeroFigure.astro';
import Base from './Base.astro';
import VerdictBox from '../components/VerdictBox.astro';
import PageMeta from '../components/PageMeta.astro';
import Toc from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import type { MarkdownHeading } from 'astro';
import ResearchNote from '../components/ResearchNote.astro';
import Sources from '../components/Sources.astro';
import PriceWatch from '../components/PriceWatch.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { iconSvg } from '../components/kitchen-icons';
import { abs, articleLd, authorOf, faqLd, getProduct, hubCrumb, productLd, urlFor } from '../lib/site';

interface Props { entry: CollectionEntry<'reviews'>; headings?: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;
const product = getProduct(d.product_id);
const author = await authorOf(d.author);
const path = urlFor(entry);
// Line-art stand-in until a licensed product image exists.
const ICON_FOR: Record<string, string> = { 'air-fryers': 'airFryer', 'kitchen-safety-devices': 'fireExtinguisher', 'espresso-machines': 'coffee', 'coffee-makers': 'mug' };

const ld = [{ ...articleLd(entry, author, path), about: { ...productLd(product), ...(d.hero && { image: abs(d.hero.src) }) } }, ...faqLd(d.faq)];
const tocExtra = d.faq?.length ? [{ slug: 'faq', text: 'Frequently asked questions' }] : [];
---

<Base title={d.title} description={d.description} crumbs={[hubCrumb(d.product_id), { name: d.title, path }]} ld={ld} disclose ogImage={d.hero?.src}>
  <article>
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <PageMeta author={author} published={d.published} updated={d.updated} />
    {d.hero && d.hero_alt ? (
      <HeroFigure src={d.hero} alt={d.hero_alt} credit={d.hero_credit} creditUrl={d.hero_credit_url} license={d.hero_license} licenseUrl={d.hero_license_url} caption={d.hero_caption} />
    ) : (
      <div class="hero-art" aria-hidden="true" set:html={iconSvg(ICON_FOR[product.category] ?? 'thermometer', 1.1)} />
    )}
    <ResearchNote subject={`the ${product.name}`} />
    <VerdictBox verdict={d.verdict} pros={d.pros} cons={d.cons} />
    <Toc headings={headings} extra={tocExtra} />
    <slot />
    <Faq faq={d.faq} />
    <PriceWatch product_id={d.product_id} />
    <Sources urls={d.sources} />
    <AuthorBox author={author} />
  </article>
</Base>

<style>
  .hero-art { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--tint); color: var(--accent); margin-bottom: 0.5rem; }
  .hero-art :global(svg) { width: 22%; height: auto; }
</style>
