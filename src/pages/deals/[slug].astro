---
import { render } from 'astro:content';
import AffiliateLink from '../../components/AffiliateLink.astro';
import Figure from '../../components/Figure.astro';
import Layout from '../../layouts/Deals.astro';
import { published, urlFor } from '../../lib/site';

export async function getStaticPaths() {
  return (await published('deals')).map((entry) => ({ params: { slug: urlFor(entry).split('/').at(-2) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout entry={entry} headings={headings}><Content components={{ AffiliateLink, Figure }} /></Layout>
