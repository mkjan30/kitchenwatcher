---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { iconSvg } from '../components/kitchen-icons';
import { getProduct, humanize, published, urlFor } from '../lib/site';

const hubs = await published('best');
const reviews = [...(await published('reviews'))].sort((a, b) => +b.data.updated - +a.data.updated);
const [lead, ...otherHubs] = hubs;
// Line-art stand-ins until real test photos exist; swap for <Picture> of the hero when there is one.
const ICON_FOR: Record<string, string> = { 'air-fryers': 'airFryer', 'kitchen-safety-devices': 'fireExtinguisher', 'espresso-machines': 'coffee', 'coffee-makers': 'mug', blenders: 'blender', 'stand-mixers': 'mixer' };
const iconFor = (category: string) => iconSvg(ICON_FOR[category] ?? 'thermometer', 1.1);
// CC licences require attribution wherever a photo appears, including here.
const credits = [...hubs, ...reviews.slice(0, 6)].filter((e) => e.data.hero && e.data.hero_credit).map((e) => e.data);
---

<Base title="Kitchen Watcher: kitchen gear research and prices" description="Air fryers, coffee and espresso machines, blenders, stand mixers and safety gear compared on the evidence: lab data, specs, owner reports and recalls.">
  {lead && (
    <section class="lead">
      {lead.data.hero && lead.data.hero_alt
        ? <a class="lead-art photo" href={urlFor(lead)} tabindex="-1"><Picture src={lead.data.hero} alt={lead.data.hero_alt} widths={[360, 720, 960]} sizes="(max-width: 640px) 92vw, 600px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" /></a>
        : <a class="lead-art" href={urlFor(lead)} aria-hidden="true" tabindex="-1" set:html={iconFor(lead.data.category)} />}
      <div class="lead-copy">
        <p class="eyebrow">{humanize(lead.data.category)}</p>
        <h1><a href={urlFor(lead)}>{lead.data.title}</a></h1>
        <p class="dek">{lead.data.description}</p>
        <p class="lead-meta">{lead.data.products.length} models compared</p>
      </div>
    </section>
  )}

  {otherHubs.length > 0 && (
    <section class="more-guides" aria-labelledby="guides-h">
      <h2 id="guides-h" class="section-h">More best-of guides</h2>
      <ul>
        {otherHubs.map((h) => (
          <li>
            <a href={urlFor(h)} class:list={[{ 'with-thumb': h.data.hero }]}>
              {h.data.hero && h.data.hero_alt && <Picture class="g-thumb" src={h.data.hero} alt={h.data.hero_alt} widths={[240, 480]} sizes="240px" formats={['avif', 'webp']} />}
              <span class="eyebrow">{humanize(h.data.category)}</span>
              <span class="g-title">{h.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {reviews.length > 0 && (
    <section aria-labelledby="latest-h">
      <h2 id="latest-h" class="section-h">Latest reviews</h2>
      <div class="grid">
        {reviews.slice(0, 6).map((r) => {
          const category = getProduct(r.data.product_id).category;
          return (
            <a class="teaser" href={urlFor(r)}>
              {r.data.hero && r.data.hero_alt
                ? <Picture class="thumb photo" src={r.data.hero} alt={r.data.hero_alt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 380px" formats={['avif', 'webp']} />
                : <span class="thumb" aria-hidden="true" set:html={iconFor(category)} />}
              <span class="eyebrow">{humanize(category)}</span>
              <span class="t-title">{r.data.title}</span>
              <span class="t-meta">Updated {r.data.updated.toISOString().slice(0, 10)}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {credits.length > 0 && (
    <p class="credits">
      Photos:{' '}
      {credits.map((c, i) => (
        <>
          {i > 0 && '; '}
          {c.hero_credit_url ? <a href={c.hero_credit_url} rel="noopener">{c.hero_credit}</a> : c.hero_credit}
          {c.hero_license && <>, {c.hero_license_url ? <a href={c.hero_license_url} rel="license noopener">{c.hero_license}</a> : c.hero_license}</>}
        </>
      ))}. Illustrative photos don't show the reviewed models unless the caption on that page says so.
    </p>
  )}

  <section class="trust" aria-labelledby="trust-h">
    <h2 id="trust-h">Why you can trust us</h2>
    <p>Every recommendation shows its evidence: measurements from independent testing labs, manufacturer specs, what owners report after months of use, and official recall records. When a number comes from someone else, we name them and link to it.</p>
    <p>We don't test products hands-on, and we say so. Commissions never change a ranking.</p>
    <p><a href="/how-we-research/">How we research</a></p>
  </section>
</Base>

<style>
  .eyebrow { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.35rem; }
  .section-h { font-family: var(--sans); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; border-top: 4px solid var(--ink); padding-top: 0.75rem; margin: 3rem 0 1.25rem; }

  .lead { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; padding-block: 2rem 1rem; }
  .lead-art { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--tint); color: var(--accent); }
  .lead-art :global(svg) { width: 42%; height: auto; }
  .lead-art.photo :global(img), .thumb.photo, :global(img.thumb) { width: 100%; height: 100%; object-fit: contain; background: var(--tint); display: block; }
  .with-thumb { display: grid !important; grid-template-columns: 120px 1fr; column-gap: 1rem; align-items: center; }
  .with-thumb :global(.g-thumb), .with-thumb :global(picture) { grid-row: span 2; }
  :global(img.g-thumb) { width: 120px; height: 90px; object-fit: contain; background: var(--tint); }
  .lead h1 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.1rem); margin: 0 0 0.75rem; }
  .lead h1 a { color: var(--ink); text-decoration: none; }
  .lead h1 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .lead-meta { margin: 0; font-size: 0.85rem; color: var(--muted); }

  .more-guides ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 0 2rem; }
  .more-guides li { border-bottom: 1px solid var(--line); }
  .more-guides a { display: block; padding-block: 0.9rem; text-decoration: none; color: var(--ink); }
  .g-title { font: 700 1.2rem/1.3 var(--serif); }
  .more-guides a:hover .g-title { text-decoration: underline; text-decoration-color: var(--accent); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 1.75rem; }
  .teaser { display: grid; align-content: start; gap: 0.1rem; text-decoration: none; color: var(--ink); }
  .thumb { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--tint); color: var(--ink-2); margin-bottom: 0.6rem; }
  .thumb :global(svg) { width: 24%; height: auto; }
  .t-title { font: 700 1.2rem/1.3 var(--serif); }
  .teaser:hover .t-title { text-decoration: underline; text-decoration-color: var(--accent); }
  .t-meta { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }

  .credits { margin: 2rem 0 0; font-size: 0.75rem; color: var(--muted); }
  .credits a { color: inherit; }
  .trust { margin-top: 2rem; padding: 2rem; background: var(--tint); }
  .trust h2 { margin-top: 0; }
  .trust p { max-width: 62ch; font-family: var(--serif); font-size: 1.1rem; }
  .trust p:last-child { margin-bottom: 0; font-family: var(--sans); font-weight: 700; font-size: 0.95rem; }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .lead { grid-template-columns: 1fr; gap: 1.25rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
