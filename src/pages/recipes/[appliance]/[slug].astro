---
import { render } from 'astro:content';
import AffiliateLink from '../../../components/AffiliateLink.astro';
import Figure from '../../../components/Figure.astro';
import Layout from '../../../layouts/Recipe.astro';
import { published } from '../../../lib/site';

export async function getStaticPaths() {
  return (await published('recipes')).map((entry) => ({ params: { appliance: entry.data.appliance, slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout entry={entry}><Content components={{ AffiliateLink, Figure }} /></Layout>
